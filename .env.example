# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Google Gemini API (Provide your API key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
