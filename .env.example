# Django Configuration
DJANGO_SECRET_KEY=django-insecure-voice-agent-local-key-super-secret-123456789
DEBUG=1
ALLOWED_HOSTS=*

# LiveKit Configuration
LIVEKIT_URL=wss://livekit.localhost
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretkey1234567890abcdef

# Centrifugo Configuration
